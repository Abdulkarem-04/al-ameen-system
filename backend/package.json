{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:schema": "wrangler d1 execute al_ameen_db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute al_ameen_db --local --file=./seed.sql",
    "db:clean": "wrangler d1 execute al_ameen_db --local --file=./clean.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "db:fresh": "npm run db:schema && npm run db:clean"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}